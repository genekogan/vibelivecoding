.aider*
.env
user_token.json
node_modules/
__pycache__/

# Auto-recorded session captures (sequestered)
shows/unsorted/*
!shows/unsorted/.gitkeep

# macOS
.DS_Store

# Autopilot — runtime artifacts (snapshots + logs are ephemeral)
autopilot/snapshots/*
!autopilot/snapshots/.gitkeep
autopilot/*.log
autopilot.log

# Drawing-room project assets — local-only research material
.drawing-room-assets/

# Machine-local symlink to the Little Martians 3D archive (optional overlay —
# recreate per machine: ln -s ~/Dev/littlemartians/3d-models lm). See AGENTS.md
# "Fresh Machine Setup".
/lm

# ── media: performance recordings live outside git, trafficked via Syncthing/rsync ──
performances/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3

# E2E harness working state and proof bundles
.e2e/
assets/tools/valloop_state.json

# ── repo policy: git holds ONLY code/text/docs/manifests/configs — never
# media or generated artifacts. Scratch/working dirs excluded wholesale;
# media extensions excluded regardless of directory. ──

# Scratch and working directories (large, ephemeral, generated)
scratchpad/
threejs/
.conflicts-from-laptop2/
autopilot/snap_*/
autopilot/snapshots*/

# Media / binary artifacts — excluded everywhere, not just above dirs
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.tiff
*.pdf
*.ppm
*.glb
*.gltf
*.blend
*.blend1
*.stl
*.zip
*.u32le
*.npy
*.bin
*.key
