.aider*
.env
user_token.json
node_modules/
__pycache__/

# Auto-recorded session captures (sequestered)
shows/unsorted/*
!shows/unsorted/.gitkeep

# macOS
.DS_Store

# Autopilot — runtime artifacts (snapshots + logs are ephemeral)
autopilot/snapshots/*
!autopilot/snapshots/.gitkeep
autopilot/*.log
autopilot.log

# Drawing-room project assets — local-only research material
.drawing-room-assets/

# ── media: performance recordings live outside git, trafficked via Syncthing/rsync ──
performances/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3

# E2E harness working state and proof bundles
.e2e/
assets/tools/valloop_state.json

# ── Generative-factory render probes — regenerable artifacts ──
# Version history is code and instructions, not artifacts. The PNGs under
# scratchpad/ are throwaway render output (gf_snap.py / probe.py regenerate
# them). The tooling and reference sketches beside them stay tracked.
scratchpad/**/*.png
