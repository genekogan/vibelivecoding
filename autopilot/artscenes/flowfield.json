{"art":"flowfield","name":"art","code":"var s=window.state;if(!s._ff){s._ff={ps:[],z:0};for(var i=0;i<400;i++){s._ff.ps[i]={x:random(width),y:random(height)};}}var f=s._ff;noStroke();fill(0,0,4,10);rect(0,0,width,height);var sc=0.0025;f.z+=0.0015;strokeWeight(1.4);for(var i=0;i<f.ps.length;i++){var p=f.ps[i];var a=noise(p.x*sc,p.y*sc,f.z)*TWO_PI*2;var h=(degrees(a)*0.6+f.z*400)%360;stroke((h+360)%360,70,95,45);point(p.x,p.y);p.x+=cos(a)*1.4;p.y+=sin(a)*1.4;if(p.x<0||p.x>width||p.y<0||p.y>height){p.x=random(width);p.y=random(height);}}"}