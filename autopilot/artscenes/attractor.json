{"art": "attractor", "name": "art", "code": "var s=window.state;if(!s._at){s._at={t:0};}var A=s._at;A.t+=0.004;fill(260,60,4,12);noStroke();rect(0,0,width,height);var a=-1.4+sin(A.t)*1.3,b=1.6+cos(A.t*0.7)*1.1,c=1.0+sin(A.t*0.5)*0.8,d=0.7+cos(A.t*0.9)*0.9;var x=0.1,y=0.1;var sc=min(width,height)/4.6;push();translate(width/2,height/2);rotate(A.t*0.3);blendMode(ADD);var hue=(A.t*120)%360;for(var i=0;i<1500;i++){var nx=sin(a*y)+c*cos(a*x);var ny=sin(b*x)+d*cos(b*y);x=nx;y=ny;fill((hue+i*0.02)%360,80,90,7);ellipse(x*sc,y*sc,1.4,1.4);}blendMode(BLEND);pop();"}