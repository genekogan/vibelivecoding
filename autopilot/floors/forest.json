{"world": "forest", "name": "floor", "code": "if(window.state.t0===undefined)window.state.t0=millis()/1000;let hz=height*0.46,cx=width/2,NR=16,NC=14,elapsed=millis()/1000-window.state.t0,scroll=elapsed*0.9;noStroke();for(let r=0;r<NR;r++){let t0=r/NR,t1=(r+1)/NR,y0=hz+Math.pow(t0,1.7)*(height-hz),y1=hz+Math.pow(t1,1.7)*(height-hz),hw0=width*(0.06+t0*0.92)/2,hw1=width*(0.06+t1*0.92)/2;for(let c=0;c<NC;c++){let u0=c/NC,u1=(c+1)/NC,n=noise(u0*3.5,r*0.5+scroll),leaf=noise(u0*9,r*1.4+scroll*1.3),hue=leaf>0.62?38:110-n*25,sat=leaf>0.62?55:45+n*25,br=22+n*24+(leaf>0.62?14:0),x0a=cx-hw0+u0*2*hw0,x0b=cx-hw0+u1*2*hw0,x1a=cx-hw1+u0*2*hw1,x1b=cx-hw1+u1*2*hw1;fill(hue,sat,br,100);quad(x0a,y0,x0b,y0,x1b,y1,x1a,y1);}}blendMode(ADD);noStroke();for(let i=0;i<24;i++){let dy=hz+((i*101+scroll*35)%(height-hz)),f=(dy-hz)/(height-hz);fill(70,50,100,10+f*12);circle(cx+(noise(i*0.7,scroll*0.2)-0.5)*width*(0.06+f*0.92),dy,6+f*20);}blendMode(BLEND);"}