{"world":"jungle","name":"floor","code":"if(window.state.t0===undefined)window.state.t0=millis()/1000;let hz=height*0.46,cx=width/2,NR=16,NC=14,elapsed=millis()/1000-window.state.t0,scroll=elapsed*0.9;noStroke();for(let r=0;r<NR;r++){let t0=r/NR,t1=(r+1)/NR,y0=hz+Math.pow(t0,1.7)*(height-hz),y1=hz+Math.pow(t1,1.7)*(height-hz),hw0=width*(0.06+t0*0.92)/2,hw1=width*(0.06+t1*0.92)/2;fill(95,55,14+t0*8,100);quad(cx-hw0,y0,cx+hw0,y0,cx+hw1,y1,cx-hw1,y1);}stroke(100,60,40,60);strokeWeight(2);for(let r=0;r<=NR;r++){let rr=r-(scroll%1),t=rr/NR;if(t<0||t>1)continue;let y=hz+Math.pow(t,1.7)*(height-hz),hw=width*(0.06+t*0.92)/2;line(cx-hw,y,cx+hw,y);}noStroke();for(let i=0;i<30;i++){let ly=hz+((i*79+scroll*30)%(height-hz)),f=(ly-hz)/(height-hz),lx=cx+(((i*113)%100)/100-0.5)*width*(0.06+f*0.92);fill((60+(i*17)%60),70,50,80);push();translate(lx,ly);rotate(i*0.7);ellipse(0,0,4+f*8,2+f*4);pop();}push();blendMode(ADD);for(let i=0;i<24;i++){let sy=hz+((i*101+scroll*20)%(height-hz)),f=(sy-hz)/(height-hz);fill(55,70,100,Math.min(35,10+f*22));circle(cx+(((i*67)%100)/100-0.5)*width*(0.06+f*0.92),sy,3+f*10);}pop();blendMode(BLEND);"}