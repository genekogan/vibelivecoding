{"world": "candyland", "name": "floor", "code": "if(window.state.t0===undefined)window.state.t0=millis()/1000;let hz=height*0.46,cx=width/2,NR=16,NC=14,elapsed=millis()/1000-window.state.t0,scroll=elapsed*0.9;noStroke();for(let r=0;r<NR;r++){let t0=r/NR,t1=(r+1)/NR,y0=hz+Math.pow(t0,1.7)*(height-hz),y1=hz+Math.pow(t1,1.7)*(height-hz),hw0=width*(0.06+t0*0.92)/2,hw1=width*(0.06+t1*0.92)/2,rr=Math.floor(r+scroll);for(let c=0;c<NC;c++){let u0=c/NC,u1=(c+1)/NC,p=(rr+c)%3,hue=p===0?335:p===1?150:280,x0a=cx-hw0+u0*2*hw0,x0b=cx-hw0+u1*2*hw0,x1a=cx-hw1+u0*2*hw1,x1b=cx-hw1+u1*2*hw1;fill(hue,38,96,100);quad(x0a,y0,x0b,y0,x1b,y1,x1a,y1);}}blendMode(ADD);noStroke();for(let r=0;r<NR;r+=2){let t0=r/NR,y0=hz+Math.pow(t0,1.7)*(height-hz),hw0=width*(0.06+t0*0.92)/2;fill(0,0,100,12);quad(cx-hw0,y0,cx+hw0,y0,cx+hw0*1.02,y0+4,cx-hw0*1.02,y0+4);}blendMode(BLEND);"}