{"world":"cityscape","name":"floor","code":"if(window.state.t0===undefined)window.state.t0=millis()/1000;let hz=height*0.46,cx=width/2,NR=16,NC=14,elapsed=millis()/1000-window.state.t0,scroll=elapsed*0.9;noStroke();for(let r=0;r<NR;r++){let t0=r/NR,t1=(r+1)/NR,y0=hz+Math.pow(t0,1.7)*(height-hz),y1=hz+Math.pow(t1,1.7)*(height-hz),hw0=width*(0.06+t0*0.92)/2,hw1=width*(0.06+t1*0.92)/2;fill(250,50,6,100);quad(cx-hw0,y0,cx+hw0,y0,cx+hw1,y1,cx-hw1,y1);}stroke(320,80,100,80);strokeWeight(2);for(let r=0;r<=NR;r++){let rr=r-(scroll%1),t=rr/NR;if(t<0||t>1)continue;let y=hz+Math.pow(t,1.7)*(height-hz),hw=width*(0.06+t*0.92)/2;line(cx-hw,y,cx+hw,y);}for(let c=0;c<=NC;c++){let u=c/NC;stroke(190,80,100,70);line(cx-width*0.03+u*width*0.06,hz,cx-width*0.49+u*width*0.98,height);}noStroke();push();blendMode(ADD);for(let i=0;i<40;i++){let sy=hz+((i*89+scroll*40)%(height-hz)),f=(sy-hz)/(height-hz),h=(i*47)%360;fill(h,80,100,Math.min(35,10+f*30));circle(cx+(((i*71)%100)/100-0.5)*width*(0.06+f*0.92),sy,2+f*6);}pop();blendMode(BLEND);"}