{"name":"balloons","code":"let s=window.state;if(!s.balloons){s.balloons=[];for(let i=0;i<16;i++)s.balloons[i]=({x:Math.random()*width,y:height+Math.random()*height,r:20+Math.random()*18,hue:Math.random()*360,vy:0.5+Math.random()*0.8,ph:Math.random()*Math.PI*2,sw:0.4+Math.random()*0.5});}push();for(let b of s.balloons){b.y-=b.vy;let sx=b.x+Math.sin(millis()/1000*b.sw+b.ph)*14;if(b.y<-b.r*1.6){b.y=height+b.r*2;b.x=Math.random()*width;}stroke(0,0,80,25);strokeWeight(1);noFill();line(sx,b.y+b.r,sx+Math.sin(millis()/900+b.ph)*6,b.y+b.r+b.r*1.8);noStroke();fill(b.hue,70,90,85);ellipse(sx,b.y,b.r*0.9,b.r*1.15);fill(b.hue,20,100,60);ellipse(sx-b.r*0.22,b.y-b.r*0.25,b.r*0.28,b.r*0.36);fill(b.hue,70,60,85);triangle(sx-3,b.y+b.r*0.55,sx+3,b.y+b.r*0.55,sx,b.y+b.r*0.7);}pop();"}
