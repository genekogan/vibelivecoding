{"name":"confetti","code":"let s=window.state;if(!s.confetti){s.confetti=[];for(let i=0;i<90;i++)s.confetti[i]=({x:Math.random()*width,y:Math.random()*height,w:6+Math.random()*8,h:3+Math.random()*5,hue:Math.random()*360,vy:1.2+Math.random()*2.4,vx:(Math.random()-0.5)*1.2,a:Math.random()*Math.PI*2,va:(Math.random()-0.5)*0.25});}push();rectMode(CENTER);noStroke();for(let c of s.confetti){c.x+=c.vx;c.y+=c.vy;c.a+=c.va;if(c.y>height+10){c.y=-10;c.x=Math.random()*width;}push();translate(c.x,c.y);rotate(c.a);fill(c.hue,80,95,90);let sq=0.5+0.5*Math.abs(Math.sin(c.a));scale(1,sq);rect(0,0,c.w,c.h);pop();}pop();"}
