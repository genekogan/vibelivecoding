{"name":"bubbles","code":"let s=window.state;if(!s.bubbles){s.bubbles=[];for(let i=0;i<60;i++)s.bubbles[i]=({x:Math.random()*width,y:height+Math.random()*height,r:6+Math.random()*22,vy:0.6+Math.random()*1.4,ph:Math.random()*Math.PI*2,sw:0.5+Math.random()*0.8,hue:180+Math.random()*60});}push();noFill();for(let b of s.bubbles){b.y-=b.vy;let sx=b.x+Math.sin(millis()/1000*b.sw+b.ph)*10;if(b.y<-b.r*2){b.y=height+b.r*2;b.x=Math.random()*width;}strokeWeight(1.5);stroke(b.hue,30,100,25);ellipse(sx,b.y,b.r*2,b.r*2);noStroke();fill(b.hue,15,100,18);ellipse(sx,b.y,b.r*1.7,b.r*1.7);fill(0,0,100,45);ellipse(sx-b.r*0.35,b.y-b.r*0.35,b.r*0.5,b.r*0.5);noFill();}pop();"}
