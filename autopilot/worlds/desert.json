{"world":"desert","code":"if(!window.state.desertBg||window.state.desertBg.width!==width){let g=createGraphics(width,height);g.colorMode(HSB,360,100,100,100);g.noStroke();let hz=height*0.46;for(let y=0;y<hz;y++){let t=y/hz;g.fill(25+t*20,70-t*20,95-t*10);g.rect(0,y,width,1);}g.fill(40,70,100);g.ellipse(width*0.5,hz*0.72,hz*0.7,hz*0.7);g.fill(50,25,100,60);g.ellipse(width*0.5,hz*0.72,hz*0.95,hz*0.95);g.fill(45,15,100);for(let i=0;i<70;i++){let x=(i*137)%width,y=(i*61)%(hz*0.5),s=(i%3)+1;g.ellipse(x,y,s,s);}let dc=[[20,60,60],[18,65,48],[16,70,36],[14,75,26]];for(let d=0;d<4;d++){let yb=hz+(height-hz)*(d*0.24);g.fill(dc[d][0],dc[d][1],dc[d][2]);g.beginShape();g.vertex(0,height);g.vertex(0,yb+20);for(let x=0;x<=width;x+=40){g.vertex(x,yb+Math.sin(x*0.008+d*2)*22);}g.vertex(width,height);g.endShape(CLOSE);}g.fill(10,80,15);for(let i=0;i<5;i++){let x=width*(0.12+i*0.19),y=hz+(height-hz)*0.28,h=40+((i*47)%40);g.rect(x-6,y-h,12,h);g.rect(x-24,y-h*0.6,18,10);g.rect(x-24,y-h*0.6-24,10,28);g.rect(x+6,y-h*0.5,18,10);g.rect(x+14,y-h*0.5-20,10,24);}window.state.desertBg=g;}image(window.state.desertBg,0,0);"}