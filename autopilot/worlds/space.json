{"world":"space","code":"if(!window.state.spaceBg||window.state.spaceBg.width!==width){let g=createGraphics(width,height);g.colorMode(HSB,360,100,100,100);g.noStroke();g.fill(255,60,6);g.rect(0,0,width,height);g.push();g.blendMode(ADD);for(let i=0;i<90;i++){let x=(i*127)%width,y=(i*73)%height,r=40+(i%6)*30,h=(200+i*30)%360;g.fill(h,70,20,5);g.ellipse(x,y,r,r);}g.pop();g.fill(0,0,100);for(let i=0;i<260;i++){let x=(i*89)%width,y=(i*151)%height,s=(i%4)*0.7+0.5;g.fill(0,0,80+(i%20),80);g.ellipse(x,y,s,s);}g.push();g.blendMode(ADD);g.translate(width*0.72,height*0.28);for(let a=0;a<260;a++){let ang=a*0.18,rad=a*0.9;g.fill((260+a)%360,60,90,25);g.ellipse(Math.cos(ang)*rad,Math.sin(ang)*rad*0.5,3,3);g.ellipse(Math.cos(ang+3.14)*rad,Math.sin(ang+3.14)*rad*0.5,3,3);}g.pop();g.fill(30,80,90);g.ellipse(width*0.22,height*0.62,140,140);g.fill(30,80,60);g.ellipse(width*0.22-30,height*0.62-30,60,60);g.push();g.translate(width*0.22,height*0.62);g.rotate(-0.4);g.noFill();g.strokeWeight(6);g.stroke(45,70,95,70);g.ellipse(0,0,240,80);g.pop();g.noStroke();g.fill(280,60,80);g.ellipse(width*0.5,height*0.8,80,80);let hz=height*0.46;g.fill(255,60,3);g.rect(0,height-6,width,6);window.state.spaceBg=g;}image(window.state.spaceBg,0,0);"}