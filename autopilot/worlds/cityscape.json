{"world":"cityscape","code":"if(!window.state.cityscapeBg||window.state.cityscapeBg.width!==width){let g=createGraphics(width,height);g.colorMode(HSB,360,100,100,100);g.noStroke();let hz=height*0.46;for(let y=0;y<hz;y++){let t=y/hz;g.fill(275-t*40,70,10+t*35);g.rect(0,y,width,1);}g.fill(55,20,100);g.ellipse(width*0.78,height*0.14,90,90);g.fill(275,60,14);g.ellipse(width*0.78,height*0.14,110,110);g.fill(0,0,100,80);for(let i=0;i<200;i++){let x=(i*137)%width,y=(i*61)%hz;g.ellipse(x,y,1,1);}for(let b=0;b<26;b++){let bx=b*(width/26),bw=width/26+2,bh=hz*(0.3+((b*53)%50)/100),by=hz-bh;g.fill(255,40,6+(b%3)*2);g.rect(bx,by,bw,bh);g.push();g.blendMode(ADD);for(let wy=by+6;wy<hz-4;wy+=10){for(let wx=bx+4;wx<bx+bw-4;wx+=8){if((wx*wy+b)%5<2){g.fill(((b*40)%360),80,90,45);g.rect(wx,wy,3,5);}}}g.pop();}g.fill(255,40,4);g.rect(0,hz,width,height-hz);window.state.cityscapeBg=g;}image(window.state.cityscapeBg,0,0);"}