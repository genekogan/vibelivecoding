{"world":"volcano","code":"if(!window.state.volcanoBg||window.state.volcanoBg.width!==width){let g=createGraphics(width,height);g.colorMode(HSB,360,100,100,100);g.noStroke();let hz=height*0.46;for(let y=0;y<hz;y++){let t=y/hz;g.fill(5+t*15,90-t*20,15+t*40);g.rect(0,y,width,1);}g.fill(0,90,8);g.rect(0,hz,width,height-hz);g.push();g.blendMode(ADD);for(let i=0;i<6;i++){let x=width*(0.5+(i-3)*0.06);g.fill(20,80,50,8);g.ellipse(x,hz*0.4,120-i*10,220);}g.pop();g.fill(0,0,4);g.beginShape();g.vertex(0,height);g.vertex(0,hz+30);g.vertex(width*0.28,hz-height*0.18);g.vertex(width*0.42,hz-height*0.36);g.vertex(width*0.5,hz-height*0.34);g.vertex(width*0.62,hz-height*0.18);g.vertex(width,hz+40);g.vertex(width,height);g.endShape(CLOSE);g.push();g.blendMode(ADD);g.fill(30,100,90,90);g.triangle(width*0.42,hz-height*0.35,width*0.5,hz-height*0.33,width*0.46,hz-height*0.5);g.fill(15,100,80);g.beginShape();g.vertex(width*0.44,hz-height*0.34);g.vertex(width*0.34,height*0.7);g.vertex(width*0.4,height);g.vertex(width*0.5,height);g.vertex(width*0.5,hz-height*0.33);g.endShape(CLOSE);g.pop();g.fill(20,100,90);for(let i=0;i<10;i++){let y=hz+(height-hz)*(i/10),x=width*0.4+Math.sin(i*1.3)*width*0.18;g.ellipse(x,y,26+i*6,7);}g.push();g.blendMode(ADD);for(let i=0;i<50;i++){let x=(i*97)%width,y=(i*57)%hz,s=1+(i%3);g.fill(25,100,95,60);g.ellipse(x,y,s,s);}g.pop();window.state.volcanoBg=g;}image(window.state.volcanoBg,0,0);"}