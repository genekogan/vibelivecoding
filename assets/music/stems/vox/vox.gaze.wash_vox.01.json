  "code": {
    "sparse": "n(\"<[0 ~ 3 ~] [2 ~ ~ 0] [~ -2 ~ 3] [5 ~ 4 ~]>\").scale(\"${root}${oct}:${mode}\").s(\"diphone\").clip(2).shape(.45).lpf(sine.range(${cut}*.5, ${cut}*1.1).slow(32)).gain(${gain}*.85).pan(sine.range(.35,.65).slow(24)).room(${room}).roomsize(8).delay(${send}).delaytime(.5).delayfeedback(.5).orbit(8).play()",
    "full": "n(\"<[0 3 ~ 2] [2 ~ 0 -2] [3 ~ 5 4] [5 4 ~ 2]>\").scale(\"${root}${oct}:${mode}\").s(\"diphone\").clip(2).shape(.5).lpf(sine.range(${cut}*.6, ${cut}*1.3).slow(24)).gain(saw.range(${gain}*.6, ${gain}).slow(2)).pan(cosine.range(.3,.7).slow(16)).off(1/4, x=>x.add(note(12)).gain(.4).lpf(1800)).every(4, x=>x.rev()).room(${room}).roomsize(9).delay(${send}).delaytime(.5).delayfeedback(.55).orbit(8).play()",
    "peak": "n(\"<[0 3 5 2] [2 3 0 -2] [3 5 7 4] [5 7 4 2]>\").scale(\"${root}${oct}:${mode}\").s(\"diphone\").clip(2).shape(.55).lpf(sine.range(${cut}*.7, ${cut}*1.5).slow(16)).gain(saw.range(${gain}*.6, ${gain}).slow(2)).pan(cosine.range(.25,.75).slow(12)).off(1/4, x=>x.add(note(12)).gain(.4).lpf(2000)).jux(rev).lastOf(8, x=>x.add(note(7))).room(${room}).roomsize(9).delay(${send}).delaytime(.375).delayfeedback(.6).orbit(8).play()"
