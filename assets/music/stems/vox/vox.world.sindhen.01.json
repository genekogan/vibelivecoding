    "sparse": "n(\"<[4 ~ [3 4] 2] [~ 2 [1 2] 0] [2 ~ [3 2] 1] [0 ~ ~ 0]>\").scale(\"${root}${oct}:${mode}\").s(\"diphone\").clip(1.4).shape(.38).lpf(sine.range(${cut}*.7,${cut}*1.2).slow(24)).gain(${gain}).pan(sine.range(.42,.58).slow(20)).room(.5).delay(${dly}).delaytime(.5).delayfeedback(.35).orbit(8).play()",
