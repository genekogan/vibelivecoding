    "sparse": "s(\"speech\").chop(4).ply(\"<1 2 1 3>\").speed(${spd}).coarse(\"<1 2 1 4>\").shape(.4).lpf(sine.range(${cut}*.6,${cut}*1.2).slow(24)).gain(saw.range(${gain}*.6, ${gain}).fast(4)).pan(sine.range(.4,.6).slow(16)).room(.3).delay(${send}).delaytime(.1875).delayfeedback(.4).orbit(8).play()",
    "full": "stack(s(\"speech\").chop(8).ply(\"<2 1 3 2>\").speed(\"<1 1.2 .8 1.5>\"), n(\"<0 5 3 8>\").s(\"numbers\").ply(\"<1 2>\").speed(1.2).gain(.6)).crush(\"<8 6 12 6>\").coarse(\"<1 2 1 3>\").shape(.45).chunk(4, x=>x.speed(2)).iter(4).every(4, x=>x.fast(2)).lpf(sine.range(${cut}*.7,${cut}*1.5).slow(16)).gain(saw.range(${gain}*.6, ${gain}).fast(4)).pan(cosine.range(.35,.65).slow(16)).room(.3).delay(${send}).delaytime(.1875).delayfeedback(.45).orbit(8).play()",
