  ],
  "mood": [
    "hypnotic",
    "clockwork"
  ],
  "energy": 2,
  "meter": "4/4",
  "cycles_per_phrase": 3,
  "key": null,
  "transpose": "none",
  "cps": {
    "written": 0.5,
    "min": 0.45,
    "max": 0.6
  },
  "claims": [],
  "deterministic": true,
  "deps": [],
  "params": {
    "fb": {
      "default": 0.62,
      "min": 0.3,
      "max": 0.8,
      "doc": "echo feedback - lattice density"
    },
    "tone": {
      "default": 4500,
      "min": 1500,
      "max": 8000,
      "doc": "lowpass on the hits"
    },
    "gain": {
      "default": 0.45,
      "min": 0.1,
      "max": 0.5,
      "doc": "dry hit level"
    }
  },
  "code": {
    "sparse": "s(\"rim ~ ~ ~\").shape(.35).lpf(${tone}).gain(${gain}*.85).delay(.7).delaytime(\"<.375 .25 .167>\").delayfeedback(${fb}).room(.15).orbit(2).play()",
    "full": "s(\"rim ~ ~ cb ~ ~ rim ~, ~ ~ ~ ~ clave ~ ~ ~\").shape(.4).lpf(${tone}).gain(saw.range(${gain}*.6,${gain}).fast(2)).delay(.65).delaytime(\"<.375 .25 .167>\").delayfeedback(${fb}).room(.15).pan(sine.range(.4,.6).slow(12)).every(8, x=>x.ply(2)).orbit(2).play()",
    "peak": "s(\"rim ~ [~ rim] cb ~ rim ~ cb, ~ ~ ~ ~ clave ~ [~ clave] ~\").shape(.45).lpf(${tone}).gain(saw.range(${gain}*.62,${gain}).fast(4)).delay(.6).delaytime(\"<.375 .167 .25 .125>\").delayfeedback(${fb}).room(.12).pan(sine.range(.32,.68).slow(8)).lastOf(4, x=>x.ply(2)).orbit(2).play()"
  },
