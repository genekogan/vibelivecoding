    "peak": "stack(n(\"{0 2 4 2 0 4 2}%7\").scale(\"${root}${oct}:${mode}\").s(\"handbells\").clip(1).gain(${gain}).pan(.35), n(\"{4 6 2 6 4 2 6}%7\").scale(\"${root}${oct}:${mode}\").add(note(12)).s(\"handbells\").clip(1).gain(${gain}*.82).pan(.65), n(\"{0 ~ ~ 4 ~ ~ 2}%7\").scale(\"${root}${oct}:${mode}\").add(note(-12)).s(\"handbells\").clip(1).gain(${gain}*.6).pan(.5)).shape(.45).lpf(sine.range(${cut}*.7, ${cut}*1.2).slow(24)).room(.28).iter(7).every(4, x=>x.rev()).orbit(2).play()"
