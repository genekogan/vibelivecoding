  "code": {
    "sparse": "note(\"d3(3,8,<0 2 4 6>)\").s(\"sine\").penv(${glide}).pdec(.07).attack(.001).decay(.2).sustain(0).release(.05).shape(.28).lpf(${cut}).gain(${gain}*.82).pan(sine.range(.38,.62).slow(24)).room(.2).fast(${rate}).orbit(2).play()",
    "full": "stack(note(\"d3(3,8,<0 2 4 6>)\").pan(sine.range(.3,.7).slow(16)).gain(${gain}), note(\"a2(3,8,<4 6 0 2>)\").pan(cosine.range(.3,.7).slow(16)).gain(${gain}*.82).every(8, x=>x.ply(2))).s(\"sine\").penv(${glide}).pdec(.07).attack(.001).decay(.2).sustain(0).release(.05).shape(.28).lpf(${cut}).room(.2).fast(${rate}).orbit(2).play()",
    "peak": "stack(note(\"d3(3,8,<0 2 4 6>)\").pan(sine.range(.25,.75).slow(16)).gain(${gain}), note(\"a2(5,8,<4 6 0 2>)\").pan(cosine.range(.25,.75).slow(16)).gain(${gain}*.82), note(\"f3(3,8,<2 5 1 6>)\").gain(${gain}*.72).every(4, x=>x.ply(2)).mask(\"<1 1 1 0>\")).s(\"sine\").penv(${glide}*1.2).pdec(.06).attack(.001).decay(.18).sustain(0).release(.05).shape(.32).lpf(${cut}).room(.2).fast(${rate}).orbit(2).play()"
  },
