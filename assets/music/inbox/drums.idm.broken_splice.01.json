  "code": {
    "sparse": "s(\"think\").splice(8, \"0 ~ [2 3] ~ 4 ~ [6 7] ~\").gain(${gain}*.85).lpf(${cut}*.6).shape(.2).every(4, rev).pan(sine.range(.35,.65).slow(16)).room(${verb}).orbit(1).play()",
    "full": "s(\"think\").splice(8, \"<[0 1 2 3 4 5 6 7] [0 3 2 5 4 7 6 1] [0 1 4 5 2 3 6 7] [0 6 [2 2] 4 1 7 [3 3] 5]>\").lastOf(4, x=>x.ply(2)).gain(${gain}).shape(.25).lpf(sine.range(${cut}*.55, ${cut}*1.4).slow(32)).room(${verb}).orbit(1).play()",
    "peak": "stack(s(\"think\").splice(16, \"<[0 1 2 3 8 9 10 11 4 5 6 7 12 13 14 15] [0 2 1 3 8 10 9 11 4 6 5 7 12 14 13 15] [0 1 2 3 8 9 10 11 4 5 6 7 [12 12] [13 13] [14 14] 15]>\").every(2, x=>x.ply(\"<1 2>\")).gain(${gain}), s(\"bd*4\").bank(\"RolandTR707\").mask(\"<1 1 1 0>\").gain(${gain}*.6)).shape(.3).lpf(sine.range(${cut}*.8, ${cut}*1.8).slow(16)).room(${verb}*.7).orbit(1).play()"
  },
