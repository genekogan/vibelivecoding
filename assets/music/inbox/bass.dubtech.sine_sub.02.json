  "name": "Skank glide sub",
  "desc": "Syncopated one-drop-flavored sine sub with a rubbery pitch-envelope glide on every note — hits on the one, the and-of-two and the four, walking Am/F/G shapes over 8 cycles. Elastic where the sibling is smooth.",
  "tags": ["dub techno", "dub", "techno", "reggae", "bass", "sub", "sine", "glide", "penv", "skank", "syncopated", "rubbery", "elastic", "deep", "a minor", "hypnotic"],
  "genre": ["dub techno", "dub", "techno"],
  "mood": ["rubbery", "hypnotic", "deep"],
  "energy": 2,
  "meter": "4/4",
  "cycles_per_phrase": 4,
  "key": {"root": "a", "mode": "minor"},
  "transpose": "add-note",
  "cps": {"written": 0.5, "min": 0.45, "max": 0.55},
  "claims": [],
  "deterministic": true,
  "deps": [],
  "params": {
    "root": {"default": 0, "min": -5, "max": 6, "doc": "semitone offset from A"},
    "gain": {"default": 0.78, "min": 0.4, "max": 0.88, "doc": "sub level"},
    "cut": {"default": 320, "min": 120, "max": 900, "doc": "sub lpf center Hz"},
    "glide": {"default": 4, "min": 0, "max": 12, "doc": "pitch-envelope glide depth in semitones"}
  },
  "code": {
    "sparse": "note(\"<a1 ~ f1 ~>\").add(note(${root})).s(\"sine\").penv(${glide}).pdec(.15).attack(.02).decay(.5).sustain(.6).release(.3).lpf(sine.range(${cut}*.5,${cut}*.9).slow(32)).shape(.15).gain(${gain}*.8).orbit(3).play()",
    "full": "note(\"<[a1 ~ ~ a1 ~ ~ e1 ~] [a1 ~ ~ a1 ~ ~ g1 ~] [f1 ~ ~ f1 ~ ~ e1 ~] [<g1 e1> ~ ~ <g1 e1> ~ ~ d1 ~]>\").add(note(${root})).s(\"sine\").penv(${glide}).pdec(.1).attack(.01).decay(.25).sustain(.45).release(.1).lpf(sine.range(${cut}*.6,${cut}*1.2).slow(32)).shape(.2).gain(saw.range(${gain}*.6,${gain}).fast(4)).every(8,x=>x.ply(2)).orbit(3).play()",
    "peak": "note(\"<a1 a1 f1 <g1 e1>>\").struct(\"x(7,16,<0 4 8 12>)\").add(note(${root})).s(\"sine\").penv(${glide}).pdec(.08).attack(.005).decay(.16).sustain(.3).release(.06).lpf(sine.range(${cut}*.8,${cut}*1.5).slow(16)).shape(.25).gain(saw.range(${gain}*.55,${gain}).fast(4)).lastOf(8,x=>x.fast(2)).orbit(3).play()"
