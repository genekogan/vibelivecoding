  "code": {
    "sparse": "n(\"<[0 4 8] [2 6 ~] [14 4 0] [~ 18 2]>\").s(\"alphabet\").gain(${gain}*.85).speed(\"<1 1.1 .9>\").lpf(${cut}).pan(sine.range(.35,.65).slow(16)).room(${room}).delay(${dly}).delaytime(.375).delayfeedback(.4).orbit(8).play()",
    "full": "stack(n(\"0 4 [8 8] 2 14 [4 ~] 0 18\").s(\"alphabet\").speed(\"<1 .9 1.1>\").gain(${gain}*.8), n(\"<11 6 19 2>\").s(\"alphabet\").speed(1.4).gain(${gain}*.5).rev()).iter(4).every(4, x=>x.rev()).lpf(sine.range(${cut}*.7,${cut}*1.4).slow(16)).pan(sine.range(.3,.7).slow(11)).room(${room}).delay(${dly}).delaytime(.375).delayfeedback(.45).orbit(8).play()",
    "peak": "stack(n(\"0 4 [8 8] 2 14 4 [0 0] 18 11 6 [19 19] 2 5 20 [4 4] 8\").s(\"alphabet\").speed(\"<1 .9 1.1 1.3>\").gain(${gain}*.8), n(\"<11 6 19 2 8 4>\").s(\"alphabet\").speed(1.5).rev().gain(${gain}*.5), n(\"0(3,8,<0 2 4>)\").s(\"alphabet\").speed(2).gain(${gain}*.4)).iter(8).every(2, x=>x.rev()).lpf(sine.range(${cut}*.8,${cut}*1.6).slow(8)).pan(sine.range(.25,.75).slow(9)).room(${room}).delay(${dly}).delaytime(.1875).delayfeedback(.5).orbit(8).play()"
