    "sparse": "note(\"d#1 ~ ~ d#1 ~ ~ [~ d#1] ~\").add(note(\"<0 -2 -4 0>\")).add(note(${root})).s(\"sine\").fm(${fmi}).fmh(3.37).fmattack(.005).fmdecay(.25).penv(${pe}).pdec(.09).attack(.005).decay(.9).sustain(.4).release(.2).lpf(sine.range(${cut}*.5, ${cut}).slow(32)).lpq(3).shape(.22).gain(${gain}*.85).room(.14).orbit(3).play()",
