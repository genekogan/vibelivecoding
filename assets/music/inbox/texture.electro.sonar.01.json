  "name": "Sonar ping delay",
  "desc": "Sonar pings in the dark — a bare sine blip repeated into long feedback delay, its euclid placement rotating around the bar while the echoes pan slowly across the trench. Sparse is one lonely ping per cycle with a masked silence every fourth; peak answers with a lower triangle echo an octave down, counter-rotated and counter-panned.",
  "tags": ["electro", "sonar", "ping", "submarine", "delay", "echo", "texture", "deep-sea", "aquatic", "drexciya", "sparse", "ambient", "sine", "radar", "signal", "lonely"],
  "genre": ["electro", "ambient", "dub"],
  "mood": ["lonely", "submerged", "vast"],
  "energy": 1,
  "meter": "4/4",
  "cycles_per_phrase": 4,
  "key": null,
  "transpose": "none",
  "cps": {"written": 0.54, "min": 0.5, "max": 0.58},
  "claims": [],
  "deterministic": true,
  "deps": [],
  "params": {
    "pitch": {"default": 76, "min": 60, "max": 88, "doc": "ping pitch (MIDI note number)"},
    "gain": {"default": 0.25, "min": 0.1, "max": 0.3, "doc": "level"},
    "dwet": {"default": 0.8, "min": 0.2, "max": 0.95, "doc": "delay send (echo intensity)"}
  },
  "code": {
    "sparse": "note(\"${pitch} ~ ~ ~\").s(\"sine\").decay(.25).sustain(0).delay(\"${dwet}:.66:.75\").lpf(3000).pan(sine.range(.3,.7).slow(24)).gain(${gain}*.9).room(.6).mask(\"<1 0 1 1>\").orbit(7).play()",
    "full": "note(\"${pitch}(3,8,<0 2 4 6>)\").s(\"sine\").decay(.2).sustain(0).delay(\"${dwet}:.5:.7\").lpf(sine.range(1800, 4000).slow(32)).pan(sine.range(.25,.75).slow(16)).gain(${gain}).room(.5).orbit(7).play()",
    "peak": "stack(note(\"${pitch}(5,8,<0 2 4 6>)\").s(\"sine\").decay(.18).sustain(0).gain(${gain}).pan(sine.range(.25,.75).slow(16)), note(\"${pitch}(3,8,<4 6 0 2>)\").add(note(-12)).s(\"triangle\").decay(.25).sustain(0).gain(${gain}*.7).pan(cosine.range(.25,.75).slow(16))).delay(\"${dwet}:.4:.65\").lpf(sine.range(2000, 4500).slow(16)).room(.45).orbit(7).play()"
