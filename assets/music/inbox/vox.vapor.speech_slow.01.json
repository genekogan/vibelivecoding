  "code": {
    "sparse": "n(\"<0 3 5 7 2 9>\").s(\"speech\").speed(${spd}).lpf(sine.range(${cut}*.6,${cut}).slow(16)).room(${room}).gain(${gain}).delay(\"${dly}:0.5:0.5\").orbit(8).play()",
    "full": "n(\"<[0 3] [5 7] [2 9] [1 4]>\").s(\"speech\").speed(${spd}).lpf(sine.range(${cut}*.6,${cut}*1.1).slow(16)).room(${room}).gain(${gain}).delay(\"${dly}:0.5:0.5\").pan(sine.range(.3,.7).slow(12)).orbit(8).play()",
    "peak": "n(\"<[0 3 5] [7 2 9] [1 4 6] [8 5 3]>\").s(\"speech\").speed(${spd}).chop(2).lpf(sine.range(${cut}*.7,${cut}*1.3).slow(12)).room(${room}).gain(${gain}).delay(\"${dly}:0.375:0.6\").every(4,x=>x.ply(2)).pan(cosine.range(.3,.7).slow(10)).orbit(8).play()"
  },
