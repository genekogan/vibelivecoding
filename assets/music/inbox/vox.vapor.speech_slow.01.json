    "room": {
      "default": 0.6,
      "min": 0.3,
      "max": 0.85,
      "doc": "room send (drowned)"
    },
    "spd": {
      "default": 0.5,
      "min": 0.25,
      "max": 1.0,
      "doc": "sample playback speed (.5 = half)"
    },
    "dly": {
