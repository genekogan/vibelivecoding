  "code": {
    "sparse": "s(\"<[bd ~ ~ ~ sd ~ ~ ~] [bd ~ ~ sd ~ ~ ~ ~]>\").bank(\"RolandTR505\").lpf(sine.range(${cut}*.6,${cut}).slow(24)).shape(.12).room(${room}).gain(${gain}*.85).orbit(1).play()",
    "full": "stack(s(\"bd ~ ~ bd sd ~ ~ ~\").gain(${gain}), s(\"hh*8\").fast(${rate}).gain(saw.range(${gain}*.2,${gain}*.42).fast(4)).pan(cosine.range(.4,.6).slow(20)), s(\"~ ~ ~ ~ ~ ~ oh ~\").gain(${gain}*.35).every(4,x=>x.late(.03))).bank(\"RolandTR505\").lpf(sine.range(${cut}*.7,${cut}*1.2).slow(32)).shape(.14).room(${room}).orbit(1).play()",
    "peak": "stack(s(\"bd ~ bd ~ sd ~ bd ~\").shape(.18).gain(${gain}), s(\"hh*16\").fast(${rate}).gain(saw.range(${gain}*.2,${gain}*.45).fast(8)).pan(sine.range(.3,.7).slow(12)), s(\"[~ cp]*2\").gain(${gain}*.4), s(\"~ oh ~ oh ~ oh ~ oh\").gain(${gain}*.3)).bank(\"RolandTR505\").lpf(sine.range(${cut}*.8,${cut}*1.4).slow(16)).shape(.16).room(${room}).every(8,x=>x.fast(2)).orbit(1).play()"
