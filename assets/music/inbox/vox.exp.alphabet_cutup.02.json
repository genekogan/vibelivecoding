  "code": {
    "sparse": "n(\"<0 8 2 14>\").s(\"alphabet\").chop(2).gain(${gain}*.85).speed(\"<1 1.2>\").mask(\"<1 1 0 1>\").lpf(${cut}).pan(sine.range(.4,.6).slow(12)).room(${room}).delay(${dly}).delaytime(.1875).delayfeedback(.35).orbit(8).play()",
    "full": "stack(n(\"0 8 [2 2] 14 4 [0 ~] 18 11\").s(\"alphabet\").chop(2).speed(\"<1 1.2 .9>\").gain(${gain}*.8).degradeBy(.12), n(\"<3 7 12 5>\").s(\"numbers\").speed(1.3).gain(${gain}*.5).rev()).mask(\"<1 1 1 [1 0]>\").iter(4).every(4, x=>x.rev()).lpf(sine.range(${cut}*.7,${cut}*1.4).slow(12)).pan(perlin.range(.3,.7).slow(9)).room(${room}).delay(${dly}).delaytime(.1875).delayfeedback(.45).orbit(8).play()",
    "peak": "stack(n(\"0 8 [2 2] 14 4 [0 0] 18 11 6 [19 19] 2 5 20 [4 4] 8\").s(\"alphabet\").chop(2).speed(\"<1 1.2 .9 1.4>\").gain(${gain}*.8).degradeBy(.15), n(\"<3 7 12 5 9 1>\").s(\"numbers\").speed(1.4).rev().gain(${gain}*.5), n(\"0(5,8,<0 2 4>)\").s(\"alphabet\").speed(2).chop(2).gain(${gain}*.4)).mask(\"<1 1 1 1 1 [1 0] 1 1>\").iter(8).every(2, x=>x.rev()).lpf(sine.range(${cut}*.8,${cut}*1.6).slow(8)).pan(perlin.range(.2,.8).slow(6)).room(${room}).delay(${dly}).delaytime(.125).delayfeedback(.5).orbit(8).play()"
