# Livecode environment — copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored and must NEVER be committed.
#
# These are only needed by stream.py (the DEFUNCT headless-browser Twitch
# streamer — see docs/archive/headless-browser-streaming.md). The supported
# streaming path is manual OBS: docs/livestreaming-obs.md, which needs none
# of this. The core server, catalogs, and shows require no secrets at all.

TWITCH_APP_ID=
TWITCH_APP_SECRET=
TWITCH_STREAM_KEY=
TWITCH_CHANNEL=
